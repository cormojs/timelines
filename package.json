{
  "name": "timelines",
  "private": true,
  "version": "0.7.0-alpha.1",
  "description": "A free, open-source app for creating interactive timelines for worldbuilding and history.",
  "author": "sreegjl",
  "packageManager": "bun@1.2.19",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:viewer": "vite --config vite.viewer.config.ts",
    "build": "electron-vite build",
    "build:viewer": "vite build --config vite.viewer.config.ts && bun -e \"require('fs').renameSync('dist-viewer/viewer.html','dist-viewer/index.html')\"",
    "build:electron": "electron-vite build",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build && electron-builder",
    "electron:build:win": "electron-vite build && electron-builder --win",
    "electron:build:mac": "electron-vite build && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test"
  },
  "build": {
    "appId": "com.timelines.app",
    "productName": "Timelines",
    "artifactName": "Timelines-${version}-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/favicon/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/favicon/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "sreegjl",
      "repo": "timelines",
      "releaseType": "prerelease"
    }
  },
  "overrides": {
    "shell-quote": "^1.10.0"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "isomorphic-git": "^1.38.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.553.0",
    "marked": "^12.0.2",
    "mp4-muxer": "^5.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/dompurify": "^3.2.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "baseline-browser-mapping": "^2.9.14",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^40.8.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7",
    "wait-on": "^9.0.3"
  }
}
